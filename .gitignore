# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# editor temp files
*.tmp.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# wrangler's local secret/env file
.dev.vars
# …but the setup documentation must reach the repo
!.env.example

# cloudflare workers (opennext adapter)
.open-next/
.wrangler/
# `npm run cf-typegen` output. Not committed: the workerd runtime globals it
# pulls in override the DOM lib project-wide (fetch/Response.json() go
# `unknown`), breaking the client components. Generate it only if you start
# reading typed bindings off getCloudflareContext().env.
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only working files
/_originals/
/.playwright-mcp/
