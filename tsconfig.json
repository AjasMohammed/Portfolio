{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  // Next re-adds ".next/dev/types/**/*.ts" here on every build, so it is left
  // in place and filtered out by `exclude` below instead.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // The dev server's scratch types. `next build` type-checks whatever this
    // tsconfig selects (see next/docs .../05-config/02-typescript.md), so a dev
    // server killed mid-write leaves a truncated validator.ts here and every
    // production build fails on it. `.next/types`, written by the build itself,
    // is the one that actually needs checking.
    ".next/dev"
  ]
}
