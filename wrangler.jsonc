{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-01",
	// nodejs_compat: the API routes declare `runtime = "nodejs"`.
	// global_fetch_strictly_public: makes fetch() to our own origin go out over
	// the internet instead of looping back into this worker.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Persisted, searchable runtime logs (3-day retention, free plan). Set
	// explicitly rather than relying on the default: Cloudflare's guidance is
	// that this file is the source of truth, and the docs do not say whether an
	// absent key preserves a dashboard-enabled setting. Worth having because
	// visits.ts and rate-limit.ts fail OPEN on a Redis error — they console.error
	// and carry on, so without logs a broken counter looks exactly like a
	// working one.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "portfolio"
		}
	],
	// ISR / use-cache store. KV rather than R2 because R2 needs a payment
	// method on the account even for its free tier. KV is eventually
	// consistent (~60s to propagate globally) and caps values at 25MB, both
	// irrelevant here: the pages are small and already revalidate at 60s.
	// Created with: npx wrangler kv namespace create NEXT_INC_CACHE_KV
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "5c8656b1be4044a58abd7f5b2d733031"
		}
	],
	// Backs revalidateTag(). Created with:
	//   npx wrangler d1 create portfolio-tag-cache
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "portfolio-tag-cache",
			"database_id": "3f5e0bdb-35b5-43ad-a5ba-e939ee48977b"
		}
	]
}